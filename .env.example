# ============================================
# HunzWeb-O51W - Environment Configuration
# ============================================
# Copy file ini ke .env dan isi nilainya

# --- Server ---
PORT=3000
NODE_ENV=development

# --- HunzAI-O51W (Google Gemini) ---
# Dapatkan gratis di: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy-your-api-key-here

# Model: gemini-2.5-flash | gemini-2.5-pro | gemini-2.0-flash
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=500
AI_SYSTEM_PROMPT=Anda adalah HunzAI-O51W, asisten customer service yang ramah, sopan, dan profesional. Jawab pertanyaan dengan singkat, jelas, dan membantu. Gunakan bahasa Indonesia.
AI_NAME=HunzAI-O51W

# --- WhatsApp ---
AUTO_REPLY=true
BOT_NAME=HunzWeb-O51W
SESSION_PATH=./sessions
RECONNECT_DELAY=3000
